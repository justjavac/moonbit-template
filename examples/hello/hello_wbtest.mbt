///|
test "render hello example" {
  inspect(
    try! render_demo(),
    content=(
      #|<article class="profile-card">
      #|  <h1>ADA</h1>
      #|
      #|  
      #|    <span>Admin</span>
      #|  
      #|
      #|  <p>Loves analytical engines.</p>
      #|  <footer>Generated by justjavac/template.</footer>
      #|
      #|</article>
      #|
    ),
  )
}

///|
test "render member branch" {
  let user = User::{ name: " Grace ", admin: false }
  let page = ProfileCard::{
    user,
    bio: @template.safe_html("<p>Compiler pioneer.</p>"),
  }
  let html = try! page.render()
  assert_true(html.contains("<h1>GRACE</h1>"))
  assert_true(html.contains("<span>Member</span>"))
  assert_true(html.contains("<p>Compiler pioneer.</p>"))
}
