import {
  "justjavac/template",
}

pkgtype(kind: "executable")

options(
  "pre-build": [
    {
      "command": "template_codegen --scan $input -o $output",
      "input": [
        "main.mbt",
        "templates/page.mtpl",
        "templates/partials/head.mtpl",
        "templates/partials/header.mtpl",
        "templates/partials/footer.mtpl",
      ],
      "output": "tpl.generated.mbt",
    },
  ],
)
